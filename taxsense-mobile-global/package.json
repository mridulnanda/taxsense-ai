{
  "name": "taxsense-mobile-global",
  "version": "1.0.0",
  "description": "Professional tax management mobile app for iOS and Android",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "detox build-framework-cache && detox build-app-ios && detox test-ios",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "lint:fix": "eslint . --ext .ts,.tsx,.js --fix",
    "typecheck": "tsc --noEmit",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android"
  },
  "dependencies": {
    "expo": "^50.0.0",
    "expo-camera": "^13.3.0",
    "expo-document-picker": "^11.5.0",
    "expo-face-detector": "^12.3.0",
    "expo-fingerprint": "^1.3.0",
    "expo-local-authentication": "^13.3.0",
    "expo-permissions": "^14.1.0",
    "expo-splash-screen": "^0.20.3",
    "expo-status-bar": "^1.5.0",
    "expo-updates": "^0.24.3",
    "react": "18.2.0",
    "react-native": "^0.73.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-reanimated": "^3.6.0",
    "react-native-screens": "^3.27.0",
    "react-native-safe-area-context": "^4.7.0",
    "react-native-svg": "^13.12.0",
    "react-native-vision-camera": "^2.13.0",
    "react-native-worklets": "^0.2.1",
    "react-navigation": "^6.1.9",
    "react-navigation-bottom-tabs": "^6.5.11",
    "react-navigation-native": "^6.1.9",
    "react-navigation-stack": "^6.3.20",
    "zustand": "^4.4.1",
    "axios": "^1.6.0",
    "@apollo/client": "^3.8.0",
    "graphql": "^16.8.0",
    "graphql-ws": "^5.14.0",
    "@react-native-async-storage/async-storage": "^1.20.0",
    "react-native-encrypted-storage": "^4.0.3",
    "react-native-mmkv": "^2.11.0",
    "react-native-document-picker": "^8.2.1",
    "react-native-image-picker": "^7.0.0",
    "react-native-fast-image": "^8.6.3",
    "react-native-pdfkit": "^1.0.0",
    "react-native-share": "^8.0.1",
    "react-native-local-resource": "^1.4.0",
    "date-fns": "^2.30.0",
    "zod": "^3.22.4",
    "lodash-es": "^4.17.21",
    "nativewind": "^2.0.11",
    "tailwindcss": "^3.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.73.0",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "babel-jest": "^29.7.0",
    "detox": "^20.15.0",
    "detox-cli": "^20.15.0",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "metro-react-native-babel-preset": "0.77.0",
    "prettier": "^3.0.0",
    "typescript": "^5.2.0",
    "eas-cli": "^5.9.0"
  },
  "private": true,
  "expo": {
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "TaxSense needs access to your camera to scan documents and receipts."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TaxSense uses Face ID to securely authenticate you."
        }
      ]
    ]
  }
}
