{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "distribution": "store"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "YOUR_ASC_APP_ID",
        "appleId": "your-apple-id@example.com",
        "password": "@keychain:FASTLANE_PASSWORD"
      },
      "android": {
        "serviceAccount": "YOUR_SERVICE_ACCOUNT_JSON_PATH",
        "track": "production"
      }
    }
  }
}
