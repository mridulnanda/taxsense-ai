# AI Module Configuration
# Copy this to .env.local and fill in your API keys

# OpenAI Configuration (Primary Provider)
OPENAI_API_KEY=sk_your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo
# Options: gpt-4-turbo, gpt-4, gpt-4-32k

# Groq Configuration (Fast Inference)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=mixtral-8x7b-32768
# Options: mixtral-8x7b-32768, llama-2-70b-chat

# Anthropic Configuration (Fallback)
ANTHROPIC_API_KEY=sk-ant_your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Options: claude-3-5-sonnet-20241022, claude-3-opus-20240229

# AI Module Settings
AI_LOG_LEVEL=info
AI_TEMPERATURE_DEFAULT=0.7
AI_MAX_TOKENS_DEFAULT=2048

# Feature Flags
ENABLE_STREAMING=true
ENABLE_COMPLIANCE_CHECKS=true
ENABLE_AUDIT_RISK_ASSESSMENT=true
ENABLE_MULTI_LANGUAGE=true

# Rate Limiting
AI_RATE_LIMIT_REQUESTS_PER_MINUTE=60
AI_RATE_LIMIT_TOKENS_PER_MINUTE=90000

# Logging
AI_LOG_FORMAT=json
AI_LOG_SENSITIVE_DATA=false

# Document Processing
MAX_DOCUMENT_SIZE_MB=10
SUPPORTED_DOCUMENT_TYPES=pdf,docx,txt,jpeg,png
OCR_ENABLED=false
